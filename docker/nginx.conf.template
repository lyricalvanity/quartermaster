server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    add_header X-Frame-Options DENY;
    add_header Referrer-Policy no-referrer;

    location / {
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache";
    }

    # a machine's own font map (ui/fonts/local.css, ignored by git); the page always links it
    location = /fonts/local.css {
        try_files $uri @no_font_map;
        add_header Cache-Control "no-cache";
    }
    location @no_font_map {
        default_type text/css;
        return 200 "/* no local font map */";
    }

    # the host agent; the bearer key is injected here, the browser never sees it
    location /api/ {
        proxy_pass ${AGENT_URL}/api/;
        proxy_http_version 1.1;
        proxy_set_header Authorization "Bearer ${AGENT_KEY}";
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_read_timeout 1h;           # the SSE stream
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding on;
    }
}
